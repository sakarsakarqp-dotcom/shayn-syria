# انسخ هذا الملف إلى .env ولا ترفعه إلى GitHub أبداً
DATABASE_URL=postgres://user:pass@host:5432/shayn
DB_SSL=true
JWT_SECRET=ضع_نصاً_عشوائياً_طويلاً_32_حرفاً_أو_أكثر
FRONTEND_ORIGIN=https://your-domain.com
PORT=3000

# شام كاش (عدّل حسب واجهتك)
SHAM_API_URL=
SHAM_API_KEY=
SHAM_WEBHOOK_SECRET=

# حساب الإدارة (سري، يُستخدم مرة واحدة في seed-admin)
ADMIN_EMAIL=
ADMIN_PHONE=
ADMIN_PASSWORD=
